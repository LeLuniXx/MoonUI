<Window x:Class="MoonUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MoonUI"
        Title="MoonUI" Height="46" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" UseLayoutRounding="True"
        AllowDrop="True"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDrop="Window_PreviewDrop"
        Loaded="Window_Loaded">

    <Border x:Name="IslandBorder" 
            Margin="15,0,15,0"
            Background="{DynamicResource IslandBackgroundBrush}" 
            CornerRadius="0,0,16,16" 
            BorderBrush="#FF23262B" 
            BorderThickness="1,0,1,1"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="IslandBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <!-- EINGEKLAPPTER ZUSTAND -->
            <StackPanel x:Name="CollapsedView" 
                        Visibility="Visible" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                
                <!-- Normale Elemente (Direkt aktiv beim Start) -->
                <StackPanel x:Name="NormalCollapsedContent" Orientation="Horizontal" Visibility="Visible" VerticalAlignment="Center">
                    <Image x:Name="IslandSpriteImage"
                           Width="24"
                           Height="24"
                           Margin="0,0,10,0"
                           Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Stretch="Uniform"
                           VerticalAlignment="Center"/>

                    <TextBlock x:Name="ClockTextBlock" 
                               Text="00:32" 
                               Foreground="White" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               VerticalAlignment="Center"/>

                    <Border Width="1.5" 
                            Height="18" 
                            Background="#FF2A2D34" 
                            Margin="12,0" 
                            VerticalAlignment="Center"/>

                    <TextBlock x:Name="WeatherIconTextBlock" Text="☁" Foreground="White" FontSize="17" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="WeatherTextBlock" Text="12°" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <!-- Live-Countdown -->
                    <StackPanel x:Name="CollapsedTimerPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <Border Width="1.5" Height="18" Background="#FF2A2D34" Margin="12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CollapsedTimerText" Text="05:00" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- AUSGEKLAPPTER ZUSTAND -->
            <Grid x:Name="ExpandedView" Visibility="Collapsed" Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Obere Leiste: Searchbar & Action-Buttons -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- SEARCHBAR -->
                    <Border Grid.Column="0" Background="#FF191B20" CornerRadius="12" BorderBrush="#FF2A2E36" BorderThickness="1" Height="34">
                        <Grid>
                            <TextBlock Text="Suchen..." 
                                       Foreground="#FF666666" 
                                       VerticalAlignment="Center" 
                                       Margin="12,0,0,0" 
                                       FontSize="13" 
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBox x:Name="SearchTextBox" 
                                     Background="Transparent" 
                                     Foreground="White" 
                                     BorderThickness="0" 
                                     CaretBrush="White"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     Padding="10,0,10,0"
                                     TextChanged="SearchTextBox_TextChanged"
                                     PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>
                        </Grid>
                    </Border>

                    <!-- Trennstrich -->
                    <Border Grid.Column="1" Width="1.5" Height="20" Background="#FF2A2D34" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- 1. Stash Icon -->
                    <Button x:Name="StashIconButton" Grid.Column="2" Width="34" Height="34" Background="#FF191B20" BorderBrush="#FF2A2E36" BorderThickness="1" Cursor="Hand" Click="StashIconButton_Click" ToolTip="Shelf / Ablage">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                        <Path Data="M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z" Fill="White" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- 2. Kalender Icon -->
                    <Button x:Name="CalendarIconButton" Grid.Column="4" Width="34" Height="34" Background="#FF191B20" BorderBrush="#FF2A2E36" BorderThickness="1" Cursor="Hand" Click="CalendarIconButton_Click" ToolTip="Google Kalender">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                        <Path Data="M19,4H18V2H16V4H8V2H6V4H5A2,2 0 0,0 3,6V20A2,2 0 0,0 5,22H19A2,2 0 0,0 21,20V6A2,2 0 0,0 19,4M19,20H5V10H19V20M19,8H5V6H19V8M7,12H12V17H7V12Z" Fill="White" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- 3. Timer Icon -->
                    <Button x:Name="TimerIconButton" Grid.Column="6" Width="34" Height="34" Background="#FF191B20" BorderBrush="#FF2A2E36" BorderThickness="1" Cursor="Hand" Click="TimerIconButton_Click" ToolTip="Timer">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                        <Path Data="M15,1H9V3H15V1M11,14H13V8H11V14M19.03,7.39L20.45,5.97C20,5.46 19.55,5 19.04,4.56L17.62,6C16.07,4.74 14.12,4 12,4A9,9 0 0,0 3,13A9,9 0 0,0 12,22C17,22 21,17.97 21,13C21,10.88 20.26,8.93 19.03,7.39M12,20A7,7 0 0,1 5,13A7,7 0 0,1 12,6A7,7 0 0,1 19,13A7,7 0 0,1 12,20Z" Fill="White" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- 4. Settings Icon -->
                    <Button x:Name="SettingsButton" Grid.Column="8" Width="34" Height="34" Background="#FF191B20" BorderBrush="#FF2A2E36" BorderThickness="1" Cursor="Hand" Click="SettingsButton_Click" ToolTip="Einstellungen">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                        <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Fill="White" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- TIMER BEREICH -->
                <Border x:Name="TimerPanel" Grid.Row="1" Visibility="Collapsed" Background="#FF191B20" CornerRadius="14" Margin="0,10,0,0" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="TimerMinusButton" Content="−" Width="30" Height="30" FontSize="16" FontWeight="Bold" Foreground="White" Background="#FF252830" BorderThickness="0" Cursor="Hand" Click="TimerMinusButton_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                            </Button>
                            <TextBlock x:Name="TimerDisplayText" Text="05:00" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0"/>
                            <Button x:Name="TimerPlusButton" Content="+" Width="30" Height="30" FontSize="16" FontWeight="Bold" Foreground="White" Background="#FF252830" BorderThickness="0" Cursor="Hand" Click="TimerPlusButton_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="TimerStartStopButton" Content="Start" Padding="14,0" Height="30" FontSize="12" FontWeight="SemiBold" Foreground="White" Background="#FF3A3F3A" BorderThickness="0" Cursor="Hand" Click="TimerStartStopButton_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="TimerResetButton" Content="↺" Width="30" Height="30" Margin="6,0,0,0" FontSize="14" Foreground="White" Background="#FF252830" BorderThickness="0" Cursor="Hand" Click="TimerResetButton_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SHELF / STASH BEREICH -->
                <Grid x:Name="StashPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,6">
                        <TextBlock Text="Shelf (Max. 3 Einträge)" Foreground="#FF8E929B" FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="Leeren" HorizontalAlignment="Right" Padding="8,2" FontSize="11" Foreground="White" Background="#FF191B20" BorderThickness="0" Cursor="Hand" Click="ClearStashButton_Click">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </Grid>

                    <!-- ListBox für exakt 3 Einträge nebeneinander -->
                    <ListBox x:Name="StashListBox"
                             Grid.Row="1"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="0"
                             Height="125"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             PreviewMouseMove="StashListBox_PreviewMouseMove"
                             MouseLeftButtonUp="StashListBox_MouseLeftButtonUp">
                        
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <!-- Kachel-Design -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardBorder" 
                                                    Background="#FF191B20" 
                                                    BorderBrush="#FF2A2E36" 
                                                    BorderThickness="1" 
                                                    CornerRadius="14" 
                                                    Height="125" 
                                                    Margin="0,0,6,0" 
                                                    Padding="8"
                                                    ClipToBounds="True">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="MouseOver">
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FF242830" Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <!-- Kachel-Inhalt mit Bildvorschau & Fallback -->
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:StashItem}">
                                <Grid>
                                    <!-- BILD-VORSCHAU -->
                                    <Image Source="{Binding Content}" 
                                           Stretch="UniformToFill" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Bild">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="File">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- TEXT- / LINK-ANSICHT -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Bild">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="File">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Content}" Foreground="#FFC5C8C6" FontSize="10" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="68" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Row="2" Text="{Binding Type}" FontSize="9" Foreground="#FF666A73" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ERGEBNISLISTE (Suche & Kalender) -->
                <ListBox x:Name="ResultsListBox" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0" Background="Transparent" Foreground="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ResultsListBox_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="#FF191B20" CornerRadius="10" Padding="10,6" BorderThickness="1" BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF242830"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF3A404D"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF20232B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SearchResultItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#FF7E828A" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#FF242830" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="9" Foreground="#FF9AA0AA" FontWeight="Medium"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Border>
</Window>