<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Apis.Calendar.v3" Version="1.78.0.4320" />
        <PackageReference Include="System.Data.OleDb" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="credentials.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Assets\sprite.png" />
        <Resource Include="Assets\sprite.png" />
        <None Remove="Assets\snow_0.png" />
        <Resource Include="Assets\snow_0.png" />
        <None Remove="Assets\snow_1.png" />
        <Resource Include="Assets\snow_1.png" />
        <None Remove="Assets\snow_2.png" />
        <Resource Include="Assets\snow_2.png" />
        <None Remove="Assets\snow_3.png" />
        <Resource Include="Assets\snow_3.png" />
    </ItemGroup>

</Project>