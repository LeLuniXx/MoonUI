<Window x:Class="MoonUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoonUI Einstellungen" Height="580" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="White">

    <Window.Resources>
        <!-- Sauberer moderner Slider Style ohne durchscheinenden Hintergrund -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Border Background="#FF181A19" CornerRadius="12" Height="32" BorderBrush="#FF2A2E2C" BorderThickness="1"/>
                            <Border Height="4" Background="#FF2A2E2C" Margin="16,0" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Margin="16,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand" Background="Transparent">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="16" Height="16" Background="White" CornerRadius="8">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.4"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Moderner Toggle-Switch im identischen Farbschema -->
        <Style x:Key="ModernToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="46" Height="26" CornerRadius="13"
                                Background="#FF181A19" BorderBrush="#FF3A3F3D" BorderThickness="1">
                            <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9"
                                    Background="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.4"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF0B6E4F"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FF0B6E4F"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fester Hintergrund mit x:Name für Live-Styling -->
    <Border x:Name="RootWindowBorder" Background="#FF181A19" BorderBrush="#FF2A2E2C" BorderThickness="1" CornerRadius="16" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Direction="270" Opacity="0.4"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header & Schließen-Button -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Einstellungen" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                
                <Button Content="OK" Width="64" Height="36" HorizontalAlignment="Right"
                        Background="#FF252927" Foreground="#FFD5DDD1" FontWeight="Medium"
                        BorderBrush="#FF3A3F3D" BorderThickness="1" Cursor="Hand"
                        Click="OkButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#FF323735"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Scrollable Content Container -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Vertical" Margin="0,0,4,0">

                    <!-- Card: Design & Opacity -->
                    <Border Background="#FF222624" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="DARSTELLUNG &amp; TRANSPARENZ" FontWeight="Medium" Foreground="#FF8A9A86" FontSize="11" Margin="0,0,0,10"/>
                            
                            <!-- Deckkraft -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Deckkraft" VerticalAlignment="Center" Foreground="White" FontSize="13"/>
                                <TextBlock x:Name="OpacityValText" Text="100%" HorizontalAlignment="Right" Foreground="#FF8A9A86" FontSize="12"/>
                            </DockPanel>
                            <Slider x:Name="OpacitySlider" Style="{StaticResource ModernSlider}" Minimum="0.2" Maximum="1.0" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="False" Margin="0,0,0,14" ValueChanged="OpacitySlider_ValueChanged"/>

                            <!-- Eckenradius -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Eckenradius" VerticalAlignment="Center" Foreground="White" FontSize="13"/>
                                <TextBlock x:Name="RadiusValText" Text="16px" HorizontalAlignment="Right" Foreground="#FF8A9A86" FontSize="12"/>
                            </DockPanel>
                            <Slider x:Name="RadiusSlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="25" Value="16" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,14" ValueChanged="RadiusSlider_ValueChanged"/>

                            <!-- Island Skalierung (Größe) -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Island Skalierung (Größe)" VerticalAlignment="Center" Foreground="White" FontSize="13"/>
                                <TextBlock x:Name="ScaleValText" Text="100%" HorizontalAlignment="Right" Foreground="#FF8A9A86" FontSize="12"/>
                            </DockPanel>
                            <Slider x:Name="ScaleSlider" Style="{StaticResource ModernSlider}" Minimum="0.8" Maximum="1.5" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="False" ValueChanged="ScaleSlider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Card: UI Farben & Hex-Codes -->
                    <Border Background="#FF222624" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="UI FARBEN (HEX)" FontWeight="Medium" Foreground="#FF8A9A86" FontSize="11" Margin="0,0,0,10"/>
                            
                            <!-- Hintergrundfarbe Island -->
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Hintergrundfarbe (Island)" VerticalAlignment="Center" Foreground="White" FontSize="13"/>
                                <TextBox x:Name="HexColorTextBox" Width="90" Height="32" HorizontalAlignment="Right"
                                         Background="#FF181A19" Foreground="White" BorderBrush="#FF3A3F3D" BorderThickness="1"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         FontSize="13" Text="#FF111215" TextChanged="HexColorTextBox_TextChanged"/>
                            </DockPanel>

                            <!-- NEU: Hintergrundfarbe Einstellungen (Unabhängig) -->
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Hintergrundfarbe (Einstellungen)" VerticalAlignment="Center" Foreground="White" FontSize="13"/>
                                <TextBox x:Name="SettingsHexColorTextBox" Width="90" Height="32" HorizontalAlignment="Right"
                                         Background="#FF181A19" Foreground="White" BorderBrush="#FF3A3F3D" BorderThickness="1"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         FontSize="13" Text="#FF181A19" TextChanged="SettingsHexColorTextBox_TextChanged"/>
                            </DockPanel>

                            <!-- Buttons für Speichern und Standard/Reset -->
                            <UniformGrid Columns="2" HorizontalAlignment="Stretch">
                                <Button Content="Speichern" Height="34" Margin="0,0,5,0"
                                        Background="#FF0B6E4F" Foreground="White" FontWeight="Medium"
                                        BorderBrush="Transparent" Cursor="Hand" Click="SaveColorButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Content="Standard" Height="34" Margin="5,0,0,0"
                                        Background="#FF3A3F3D" Foreground="White" FontWeight="Medium"
                                        BorderBrush="Transparent" Cursor="Hand" Click="ResetColorButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Card: Module & Effekte (Schneeflocken) -->
                    <Border Background="#FF222624" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="MODULE &amp; EFFEKTE" FontWeight="Medium" Foreground="#FF8A9A86" FontSize="11" Margin="0,0,0,10"/>
                            
                            <!-- Desktop Schneefall An/Aus -->
                            <DockPanel>
                                <TextBlock Text="Desktop Schneefall" VerticalAlignment="Center" Foreground="White" FontSize="13"/>
                                <CheckBox x:Name="SnowToggle" Style="{StaticResource ModernToggle}" HorizontalAlignment="Right"
                                          Checked="SnowToggle_Changed" Unchecked="SnowToggle_Changed"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>